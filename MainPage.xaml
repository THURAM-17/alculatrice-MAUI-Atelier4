<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculatriceMAUI.MainPage"
             BackgroundColor="#17171C">
    <Grid RowDefinitions="*,Auto,Auto" Padding="20" RowSpacing="10">
        <!-- Écran d'affichage -->
        <VerticalStackLayout Grid.Row="0" VerticalOptions="End" HorizontalOptions="End" Padding="10">
            <Label x:Name="CurrentInputLabel" Text="0" FontSize="64" TextColor="White" HorizontalOptions="End" LineBreakMode="NoWrap"/>
        </VerticalStackLayout>
        
        <!-- Grille des boutons -->
        <Grid Grid.Row="1" RowDefinitions="0,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*,*,*" RowSpacing="12" ColumnSpacing="12">
            <!-- Ligne 1 -->
            <Button Grid.Row="1" Grid.Column="0" Text="C" Clicked="OnClearClicked" BackgroundColor="#A5A5A5" TextColor="Black" FontAttributes="Bold" FontSize="24" CornerRadius="40" HeightRequest="80" WidthRequest="80"/>
            <Button Grid.Row="1" Grid.Column="1" Text="+/-" Clicked="OnCalculateClicked" BackgroundColor="#A5A5A5" TextColor="Black" FontAttributes="Bold" FontSize="24" CornerRadius="40" HeightRequest="80" WidthRequest="80"/>
            <Button Grid.Row="1" Grid.Column="2" Text="%" Clicked="OnCalculateClicked" BackgroundColor="#A5A5A5" TextColor="Black" FontAttributes="Bold" FontSize="24" CornerRadius="40" HeightRequest="80" WidthRequest="80"/>
            <Button Grid.Row="1" Grid.Column="3" Text="/" Clicked="OnOperatorClicked" BackgroundColor="#FF9F0A" TextColor="White" FontAttributes="Bold" FontSize="28" CornerRadius="40" HeightRequest="80" WidthRequest="80"/>
            
            <!-- Ligne 2 -->
            <Button Grid.Row="2" Grid.Column="0" Text="7" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White" FontSize="28" CornerRadius="40" HeightRequest="80" WidthRequest="80"/>
            <Button Grid.Row="2" Grid.Column="1" Text="8" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White" FontSize="28" CornerRadius="40" HeightRequest="80" WidthRequest="80"/>
            <Button Grid.Row="2" Grid.Column="2" Text="9" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White" FontSize="28" CornerRadius="40" HeightRequest="80" WidthRequest="80"/>
            <Button Grid.Row="2" Grid.Column="3" Text="x" Clicked="OnOperatorClicked" BackgroundColor="#FF9F0A" TextColor="White" FontAttributes="Bold" FontSize="28" CornerRadius="40" HeightRequest="80" WidthRequest="80"/>
            
            <!-- Ligne 3 -->
            <Button Grid.Row="3" Grid.Column="0" Text="4" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White" FontSize="28" CornerRadius="40" HeightRequest="80" WidthRequest="80"/>
            <Button Grid.Row="3" Grid.Column="1" Text="5" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White" FontSize="28" CornerRadius="40" HeightRequest="80" WidthRequest="80"/>
            <Button Grid.Row="3" Grid.Column="2" Text="6" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White" FontSize="28" CornerRadius="40" HeightRequest="80" WidthRequest="80"/>
            <Button Grid.Row="3" Grid.Column="3" Text="-" Clicked="OnOperatorClicked" BackgroundColor="#FF9F0A" TextColor="White" FontAttributes="Bold" FontSize="28" CornerRadius="40" HeightRequest="80" WidthRequest="80"/>
            
            <!-- Ligne 4 -->
            <Button Grid.Row="4" Grid.Column="0" Text="1" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White" FontSize="28" CornerRadius="40" HeightRequest="80" WidthRequest="80"/>
            <Button Grid.Row="4" Grid.Column="1" Text="2" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White" FontSize="28" CornerRadius="40" HeightRequest="80" WidthRequest="80"/>
            <Button Grid.Row="4" Grid.Column="2" Text="3" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White" FontSize="28" CornerRadius="40" HeightRequest="80" WidthRequest="80"/>
            <Button Grid.Row="4" Grid.Column="3" Text="+" Clicked="OnOperatorClicked" BackgroundColor="#FF9F0A" TextColor="White" FontAttributes="Bold" FontSize="28" CornerRadius="40" HeightRequest="80" WidthRequest="80"/>
            
            <!-- Ligne 5 -->
            <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="0" Clicked="OnNumberClicked" BackgroundColor="#333333" TextColor="White" FontSize="28" CornerRadius="40" HeightRequest="80" HorizontalOptions="FillAndExpand"/>
            <Button Grid.Row="5" Grid.Column="2" Text="," Clicked="OnDecimalClicked" BackgroundColor="#333333" TextColor="White" FontSize="28" CornerRadius="40" HeightRequest="80" WidthRequest="80"/>
            <Button Grid.Row="5" Grid.Column="3" Text="=" Clicked="OnCalculateClicked" BackgroundColor="#FF9F0A" TextColor="White" FontAttributes="Bold" FontSize="28" CornerRadius="40" HeightRequest="80" WidthRequest="80"/>
        </Grid>
    </Grid>
</ContentPage>